+    const int nb = n / QK_SA;
+    const __m256i ones = _mm256_set1_epi8(1);
+
+    __m256 sumf = _mm256_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        const uint8_t * qs = x + i*bsz;
