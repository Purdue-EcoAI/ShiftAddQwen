+    quantize_row_##name##_ref(x, (block_##name *) y, k);                                                                \
+}                                                                                                                       \
+void ggml_vec_dot_##name##_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
