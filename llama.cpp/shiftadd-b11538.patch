+// block-wise ShiftAdd, pieces shared across the rows of a thread block: the scale codes of one
+// (super-block, chunk) are common to the BR rows of a group and the q8_1 chunk is common to all rows
+template <int Q, int BC, int BR, typename block_t>
+static __device__ __forceinline__ void sab_gather_codes(
+        const void * __restrict__ vbq, const int kbx_group, const int iqs, const uint32_t stride_row_x, uint8_t * codes) {
+    constexpr int NK  = QK_SA / BC;
+    constexpr int L   = GGML_SAB_L(Q, BC, BR);
+    constexpr int CPC = 32 / BC;
+    const uint8_t * gbase = (const uint8_t *) ((const block_t *) vbq + kbx_group) + Q*32;
+    const size_t row_bytes = (size_t) stride_row_x * sizeof(block_t);
+#pragma unroll
+    for (int p = 0; p < Q; ++p) {
+        const int idx0 = p*NK + iqs*CPC;
+        int slot = idx0 / L;
+        int off  = idx0 % L;
+#pragma unroll
+        for (int kk = 0; kk < CPC; ++kk) {
+            codes[p*CPC + kk] = gbase[slot*row_bytes + off];
+            if (++off == L) { off = 0; ++slot; }
+        }
+    }
