+class _SABBase:
+    """Block-wise ShiftAdd / BCQ: one u8 scale code per plane per tile of BC columns x BR rows.
+    Per-row block: qs[Q*32] sign planes | a[L] slice of the (row group, super-block) table | d fp16 | t slot.
+    The table is shared by BR rows, so these types only convert whole rows: use pack / dequantize_rows."""
+    Q = 3
+    BC = 8
+    BR = 32
+
+    @classmethod
+    def _dims(cls):
+        NK = 256 // cls.BC
+        L = cls.Q * NK // cls.BR
+        return NK, L, cls.Q * 32 + L + 3
+
+    @classmethod
+    def pack(cls, bits: np.ndarray, table: np.ndarray, d: np.ndarray) -> np.ndarray:
+        """bits [R, Q, C] in {0,1}; table [R//BR, C//256, Q, 256//BC] u8; d [R, C//256] float -> raw [R, (C//256)*size]"""
+        R, Q, C = bits.shape
+        NK, L, size = cls._dims()
+        nb = C // 256
+        assert R % cls.BR == 0 and C % 256 == 0 and table.shape == (R // cls.BR, nb, Q, NK), (bits.shape, table.shape)
+        qs = np.packbits(bits.astype(np.uint8).reshape(R, Q, nb, 32, 8), axis=-1, bitorder="little").reshape(R, Q, nb, 32)
+        qs = qs.transpose(0, 2, 1, 3).reshape(R, nb, Q * 32)
+        t = (np.arange(R) % cls.BR)
+        slices = table.astype(np.uint8).reshape(R // cls.BR, nb, cls.BR, L)       # slot-major slices
+        a = slices[np.arange(R) // cls.BR, :, t, :]                               # [R, nb, L]
+        dd = d.astype(np.float16).reshape(R, nb, 1).view(np.uint8)                # [R, nb, 2]
+        tt = np.broadcast_to(t.astype(np.uint8)[:, None, None], (R, nb, 1))
+        return np.concatenate([qs, a, dd, tt], axis=-1).reshape(R, nb * size)
+
+    @classmethod
+    def unpack(cls, raw: np.ndarray):
+        """raw [R, nb*size] -> bits [R, Q, C], table [R//BR, nb, Q, NK] u8, d [R, nb] f32"""
+        NK, L, size = cls._dims()
+        R = raw.shape[0]
+        nb = raw.shape[1] // size
+        blk = raw.reshape(R, nb, size)
+        qs = blk[:, :, : cls.Q * 32].reshape(R, nb, cls.Q, 32)
+        bits = np.unpackbits(qs, axis=-1, bitorder="little").transpose(0, 2, 1, 3).reshape(R, cls.Q, nb * 256)
+        a = blk[:, :, cls.Q * 32 : cls.Q * 32 + L]
+        t = blk[:, 0, -1].astype(np.int64)
+        assert np.array_equal(t, np.arange(R) % cls.BR), "row slots are not a clean sequence of row groups"
+        table = a.reshape(R // cls.BR, cls.BR, nb, L).transpose(0, 2, 1, 3).reshape(R // cls.BR, nb, cls.Q, NK)
+        d = blk[:, :, cls.Q * 32 + L : cls.Q * 32 + L + 2].copy().view(np.float16).astype(np.float32).reshape(R, nb)
+        return bits, table, d
+
+    @classmethod
+    def dequantize_rows(cls, raw: np.ndarray) -> np.ndarray:
+        bits, table, d = cls.unpack(raw)
+        R, Q, C = bits.shape
+        s = bits.astype(np.float32) * 2 - 1                                      # [R, Q, C]
+        codes = np.repeat(table, cls.BR, axis=0).astype(np.float32)             # [R, nb, Q, NK]
+        codes = np.repeat(codes, cls.BC, axis=-1).transpose(0, 2, 1, 3).reshape(R, Q, C)
+        return (s * codes).sum(1) * np.repeat(d, 256, axis=1)
+
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        raise NotImplementedError(f"{cls.__name__}: scales are shared across {cls.BR} rows; build with pack()")
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        raise NotImplementedError(f"{cls.__name__}: scales are shared across {cls.BR} rows; use dequantize_rows(raw[R, :])")
+
+
+class SAB3_8X32(_SABBase, __Quant, qtype=GGMLQuantizationType.SAB3_8X32):
+    Q = 3
+    BC = 8
+    BR = 32
+
+
+class SAB2_8X32(_SABBase, __Quant, qtype=GGMLQuantizationType.SAB2_8X32):
+    Q = 2
+    BC = 8
+    BR = 32
+
+
