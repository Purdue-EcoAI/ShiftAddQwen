+    int acc = 0;
+#pragma unroll
+    for (int p = 0; p < Q; ++p) {
+        const int bits = get_int_b1(bx->qs, p*8 + iqs);
+        const int idx0 = p*NK + iqs*CPC;
+        int slot = idx0 / L;
+        int off  = idx0 % L;
+#pragma unroll
+        for (int kk = 0; kk < CPC; ++kk) {
+            const int code = gbase[slot*row_bytes + off];
+            int part = 0;
+#pragma unroll
+            for (int q = 0; q < NPB; ++q) {
+                const int k = kk*NPB + q;
+                const int m = (((bits >> (4*k)) & 0xF) * 0x00204081) & 0x01010101;
+                part += 2*ggml_cuda_dp4a(m, u[k], 0) - sx[k];
