+// reference quantizer over whole row groups: greedy BCQ + alternating LS per tile, one fp16 gain per
+// (group, super-block) replicated over its rows (a calibrated exporter can write better per-row gains)
+static size_t sab_quant_rows(const float * GGML_RESTRICT src, uint8_t * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row,
+                             const float * imatrix, int Q, int BC, int BR) {
+    GGML_ASSERT(n_per_row % QK_SA == 0);
+    GGML_ASSERT(nrow % BR == 0 && "block-wise ShiftAdd types must be quantized in whole row groups");
+    const int NK = QK_SA / BC;
+    const int L  = GGML_SAB_L(Q, BC, BR);
+    const size_t bs = sab_block_size(Q, BC, BR);
+    const int64_t nb = n_per_row / QK_SA;
+    const size_t row_size = nb*bs;
+    const int nt = BR*BC;
+    float * tile  = (float *) malloc(3*nt*sizeof(float));
+    float * imp   = tile + nt;
+    float * r     = tile + 2*nt;
+    float alpha[8*QK_SA];
+    uint8_t T[8*QK_SA];
+    for (int64_t g = 0; g < nrow/BR; ++g) {
+        for (int64_t b = 0; b < nb; ++b) {
+            float amax = 0.0f;
+            for (int kk = 0; kk < NK; ++kk) {
+                for (int s = 0; s < BR; ++s) {
+                    const float * row = src + (g*BR + s)*n_per_row + b*QK_SA + kk*BC;
+                    for (int c = 0; c < BC; ++c) {
+                        tile[s*BC + c] = row[c];
+                        imp[s*BC + c]  = imatrix ? imatrix[b*QK_SA + kk*BC + c] : 1.0f;
+                    }
+                }
+                float al[8];
+                sa_fit_group(tile, imatrix ? imp : NULL, nt, Q, al, r);
+                for (int p = 0; p < Q; ++p) {
+                    alpha[p*NK + kk] = al[p];
+                    amax = MAX(amax, al[p]);
+                }
+            }
+            const ggml_half dh = GGML_FP32_TO_FP16(amax / 255.0f);
+            const float dq = GGML_FP16_TO_FP32(dh);
+            const float id = dq > 0 ? 1.0f/dq : 0.0f;
+            for (int i = 0; i < Q*NK; ++i) {
+                T[i] = (uint8_t) MIN(255, MAX(0, (int) nearbyintf(alpha[i]*id)));
+            }
+            for (int s = 0; s < BR; ++s) {
+                const int64_t rr = g*BR + s;
+                uint8_t * blk = dst + rr*row_size + b*bs;
+                memset(blk, 0, Q*QK_SA/8);
+                const float * row = src + rr*n_per_row + b*QK_SA;
+                for (int kk = 0; kk < NK; ++kk) {
+                    float aq[8];
+                    for (int p = 0; p < Q; ++p) aq[p] = dq*T[p*NK + kk];
+                    for (int j = kk*BC; j < (kk + 1)*BC; ++j) {
+                        const int c = sa_nearest(row[j], aq, Q);
+                        for (int p = 0; p < Q; ++p) if ((c >> p) & 1) blk[p*32 + j/8] |= (uint8_t)(1 << (j%8));
+                    }
+                }
+                memcpy(blk + Q*QK_SA/8, T + s*L, L);
+                memcpy(blk + bs - 3, &dh, sizeof(dh));
+                blk[bs - 1] = (uint8_t) s;
+            }
+        }
+    }
+    free(tile);
+    return nrow*row_size;
+}
