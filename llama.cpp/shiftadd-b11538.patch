+// ====================== block-wise ShiftAdd / BCQ (sab<Q>_<BC>x<BR>) ======================
+// Generic over Q (planes), BC (tile columns) and BR (tile rows = row group); see ggml-common.h.
+
+static inline size_t sab_block_size(int Q, int BC, int BR) { return (size_t) Q*QK_SA/8 + GGML_SAB_L(Q, BC, BR) + 3; }
+
+// re-assemble the (group, super-block) scale table from the BR row blocks; blk = this row's block of the
+// super-block, row_size = bytes per row
+static void sab_gather(const uint8_t * GGML_RESTRICT blk, size_t row_size, int t, int Q, int BC, int BR, uint8_t * GGML_RESTRICT T) {
+    const int L = GGML_SAB_L(Q, BC, BR);
+    const uint8_t * base = blk - (size_t) t*row_size;
+    for (int s = 0; s < BR; ++s) {
+        memcpy(T + s*L, base + (size_t) s*row_size + Q*QK_SA/8, L);
+    }
+}
+
+static void sab_dequant_row(const uint8_t * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k, int Q, int BC, int BR) {
+    assert(k % QK_SA == 0);
+    const int NK = QK_SA / BC;
+    const size_t bs = sab_block_size(Q, BC, BR);
+    const int64_t nb = k / QK_SA;
+    const size_t row_size = nb*bs;
+    const int t = x[bs - 1];
+    uint8_t T[8*QK_SA];
+    for (int64_t b = 0; b < nb; ++b) {
+        const uint8_t * blk = x + b*bs;
+        sab_gather(blk, row_size, t, Q, BC, BR, T);
+        ggml_half dh; memcpy(&dh, blk + bs - 3, sizeof(dh));
+        const float d = GGML_FP16_TO_FP32(dh);
+        for (int j = 0; j < QK_SA; ++j) {
+            const int kk = j / BC;
+            int v = 0;
+            for (int p = 0; p < Q; ++p) {
+                const int c = T[p*NK + kk];
+                v += ((blk[p*32 + j/8] >> (j%8)) & 1) ? c : -c;
+            }
+            y[b*QK_SA + j] = d * (float) v;
+        }
+    }
+}
