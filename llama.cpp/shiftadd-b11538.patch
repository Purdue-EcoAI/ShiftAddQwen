+// block-wise ShiftAdd: gather the group's scale table per super-block, then integer dot per 32-column chunk
+static inline float ggml_vec_dot_sab_q8_0_impl(int n, const uint8_t * GGML_RESTRICT x, const block_q8_0 * GGML_RESTRICT y, int Q, int BC, int BR) {
+    assert(n % QK_SA == 0);
+    const int NK = QK_SA / BC;
+    const int L  = GGML_SAB_L(Q, BC, BR);
+    const size_t bsz = (size_t) Q*QK_SA/8 + L + 3;
+    const int nb = n / QK_SA;
+    const size_t row_size = nb*bsz;
+    const int t = x[bsz - 1];
+    uint8_t T[8*QK_SA];
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; ++i) {
+        const uint8_t * blk = x + i*bsz;
+        const uint8_t * base = blk - (size_t) t*row_size;
+        for (int s = 0; s < BR; ++s) {
+            memcpy(T + s*L, base + (size_t) s*row_size + Q*QK_SA/8, L);
+        }
+        ggml_half dh; memcpy(&dh, blk + bsz - 3, sizeof(dh));
+        const float d = GGML_CPU_FP16_TO_FP32(dh);
+        float acc = 0.0f;
+        for (int c = 0; c < QK_SA/32; ++c) {
+            const block_q8_0 * yb = &y[i*(QK_SA/32) + c];
+            int isum = 0;
+            for (int j = 0; j < 32; ++j) {
+                const int col = 32*c + j;
+                const int kk  = col / BC;
+                int v = 0;
+                for (int p = 0; p < Q; ++p) {
+                    const int code = T[p*NK + kk];
+                    v += ((blk[p*32 + col/8] >> (col%8)) & 1) ? code : -code;
+                }
+                isum += v * yb->qs[j];
+            }
+            acc += GGML_CPU_FP16_TO_FP32(yb->d) * (float) isum;
+        }
+        sumf += d * acc;
+    }
+    return sumf;
