+template <int Q, int BC, int BR, typename block_t>
+static __device__ __forceinline__ float sab_dot(const block_t * __restrict__ bx, const int iqs, const uint8_t * codes, const sab_act_t & a) {
+    constexpr int CPC = 32 / BC;
+    constexpr int NPB = BC / 4;
+    int acc = 0;
+#pragma unroll
+    for (int p = 0; p < Q; ++p) {
+        const int bits = sizeof(block_t) % 2 == 0 ? get_int_b2(bx->qs, p*8 + iqs) : get_int_b1(bx->qs, p*8 + iqs);
+#pragma unroll
+        for (int kk = 0; kk < CPC; ++kk) {
