+static __device__ __forceinline__ void sab_prep_act(const block_q8_1 * __restrict__ by, sab_act_t & a) {
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        a.u[k]  = get_int_b4(by->qs, k);
+        a.sx[k] = ggml_cuda_dp4a(0x01010101, a.u[k], 0);
+    }
+    a.d8 = __low2float(by->ds);
