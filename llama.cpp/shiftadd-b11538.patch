+#pragma unroll
+            for (int q = 0; q < NPB; ++q) {
+                const int k = kk*NPB + q;
+                const int m = (((bits >> (4*k)) & 0xF) * 0x00204081) & 0x01010101;
+                part += 2*ggml_cuda_dp4a(m, a.u[k], 0) - a.sx[k];
+            }
+            acc += (int) codes[p*CPC + kk] * part;
+        }
+    }
+    return ggml_cuda_sa_d(bx) * a.d8 * (float) acc;
