+// ShiftAdd / BCQ: one warp per 256-element super-block, each thread expands one byte of every bit-plane (8 elements)
+template <int Q, int G, typename block_t, typename dst_t>
+static __global__ void dequantize_block_sa(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const block_t * x = (const block_t *) vx + i;
+    const int t = threadIdx.x; // 0..31 -> elements 8t..8t+7
+    const float d = ggml_cuda_sa_d(x);
+    const int g = 8*t / G;
+    float v[8] = {0.0f};
+#pragma unroll
+    for (int p = 0; p < Q; ++p) {
+        const float al = d * x->a[g*Q + p];
+        const int byte = x->qs[p*32 + t];
+#pragma unroll
+        for (int l = 0; l < 8; ++l) {
+            v[l] += ((byte >> l) & 1) ? al : -al;
+        }
+    }
+    dst_t * y = yy + i*QK_SA + 8*t;
+#pragma unroll
+    for (int l = 0; l < 8; ++l) {
+        y[l] = ggml_cuda_cast<dst_t>(v[l]);
+    }
+}
+
+template <int Q, int G, typename block_t, typename dst_t>
+static void dequantize_row_sa_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    const int64_t nb = k / QK_SA;
+    dequantize_block_sa<Q, G, block_t><<<nb, 32, 0, stream>>>(vx, y);
+}
+
+
+// block-wise ShiftAdd: one CTA per (row group, super-block); the group's scale table is gathered into smem
+// from the BR row blocks, then the BR x 256 tile is expanded (thread = column, loop over rows)
+template <int Q, int BC, int BR, typename block_t, typename dst_t>
+static __global__ void dequantize_block_sab(const void * __restrict__ vx, dst_t * __restrict__ y,
+        const int64_t ne00, const int64_t ne01, const int64_t ne02, const int64_t s01, const int64_t s02, const int64_t s03) {
+    constexpr int NK = QK_SA / BC;
+    constexpr int L  = GGML_SAB_L(Q, BC, BR);
+    __shared__ uint8_t T[Q*NK];
+    const int64_t nb  = ne00 / QK_SA;
+    const int64_t gi  = blockIdx.x / nb;
+    const int64_t b   = blockIdx.x % nb;
+    const int64_t i02 = blockIdx.y;
+    const int64_t i03 = blockIdx.z;
+    const uint8_t * base = (const uint8_t *) vx + (i03*s03 + i02*s02 + gi*BR*s01 + b) * sizeof(block_t);
+    const size_t row_bytes = (size_t) s01 * sizeof(block_t);
+    const int tid = threadIdx.x;
+    if (tid < BR) {
+        const uint8_t * a = base + tid*row_bytes + Q*32;
+#pragma unroll
+        for (int l = 0; l < L; ++l) {
+            T[tid*L + l] = a[l];
+        }
+    }
+    __syncthreads();
+    const int j  = tid;        // column inside the super-block
+    const int kk = j / BC;
+    dst_t * yrow = y + ((i03*ne02 + i02)*ne01 + gi*BR)*ne00 + b*QK_SA + j;
+    for (int s = 0; s < BR; ++s) {
+        const block_t * blk = (const block_t *) (base + s*row_bytes);
+        int v = 0;
+#pragma unroll
+        for (int p = 0; p < Q; ++p) {
+            const int code = T[p*NK + kk];
+            v += ((blk->qs[p*32 + j/8] >> (j%8)) & 1) ? code : -code;
+        }
+        yrow[s*ne00] = ggml_cuda_cast<dst_t>(ggml_cuda_sa_d(blk) * (float) v);
+    }
+}
+
+template <int Q, int BC, int BR, typename block_t, typename dst_t>
+static void dequantize_sab_nc_cuda(const void * x, dst_t * y, int64_t ne00, int64_t ne01, int64_t ne02, int64_t ne03,
+        int64_t s01, int64_t s02, int64_t s03, cudaStream_t stream) {
+    GGML_ASSERT(ne00 % QK_SA == 0 && ne01 % BR == 0);
+    const dim3 grid((ne01/BR) * (ne00/QK_SA), ne02, ne03);
+    dequantize_block_sab<Q, BC, BR, block_t><<<grid, QK_SA, 0, stream>>>(x, y, ne00, ne01, ne02, s01, s02, s03);
+}
