+#define SAB2_8X32_BR 32
+#define SAB4_8X32_Q 4
+#define SAB4_8X32_BC 8
+#define SAB4_8X32_BR 32
+GGML_SAB_BLOCK(block_sab3_8x32, SAB3_8X32_Q, SAB3_8X32_BC, SAB3_8X32_BR)
+GGML_SAB_BLOCK(block_sab2_8x32, SAB2_8X32_Q, SAB2_8X32_BC, SAB2_8X32_BR)
+GGML_SAB_BLOCK(block_sab4_8x32, SAB4_8X32_Q, SAB4_8X32_BC, SAB4_8X32_BR)
+
