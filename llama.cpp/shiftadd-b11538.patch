+GGML_SA_BLOCK(block_sa2_256, SA2_256_Q, SA2_256_G)
+GGML_SA_BLOCK(block_sa3_256, SA3_256_Q, SA3_256_G)
+GGML_SA_BLOCK(block_sa4_256, SA4_256_Q, SA4_256_G)
+GGML_SA_BLOCK(block_sa5, SA5_Q, SA5_G)
+GGML_SA_BLOCK(block_sa5_128, SA5_128_Q, SA5_128_G)
+GGML_SA_BLOCK(block_sa5_256, SA5_256_Q, SA5_256_G)
+GGML_SA_BLOCK(block_sa6, SA6_Q, SA6_G)
+GGML_SA_BLOCK(block_sa6_128, SA6_128_Q, SA6_128_G)
+GGML_SA_BLOCK(block_sa6_256, SA6_256_Q, SA6_256_G)
+
+// Block-wise ShiftAdd / BCQ (ShiftAddLLM Fig. 3(a) generalised): one u8 scale code per plane per TILE of
+// BC input columns x BR output rows.  Row group g = r / BR (slot t = r % BR), column super-block b = j / 256,
+// column block k = (j % 256) / BC.  The (g, b) table T[p * (256/BC) + k] (Q * 256/BC codes) is stored as
+// per-row slices: the row with slot t holds bytes [t*L, (t+1)*L), L = Q*(256/BC)/BR, so the table is
+// re-assembled from the BR row blocks of the group (row stride = ne0/256 blocks).  d is a per-row,
+// per-super-block fp16 gain:  w[r][j] = d[r][b] * sum_p T[p][k(j)] * (bit_p(r, j) ? +1 : -1).
+#define GGML_SAB_L(Q, BC, BR) ((Q)*(QK_SA/(BC))/(BR))
+#define GGML_SAB_BLOCK(NAME, Q, BC, BR)                                                  \
+typedef struct {                                                                        \
+    uint8_t qs[(Q)*QK_SA/8];        /* this row's sign bit-planes, plane-major */        \
+    uint8_t a[GGML_SAB_L(Q, BC, BR)]; /* this row's slice of the group scale table */   \
+    uint8_t d[2];                   /* fp16 row x super-block gain, raw bytes */         \
+    uint8_t t;                      /* slot of this row inside its row group */          \
+} NAME;                                                                                 \
+static_assert(((Q)*(QK_SA/(BC))) % (BR) == 0, #NAME ": table must split evenly over the row group"); \
+static_assert(sizeof(NAME) == (Q)*QK_SA/8 + GGML_SAB_L(Q, BC, BR) + 3, "wrong " #NAME " size/padding");
